@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tarefa</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Tarefa/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="Descricao" class="control-label">Descrição</label>
                <input type="text" id="Descricao" name="Descricao" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="DataPlanejada" class="control-label">Data Planejada</label>
                <input type="datetime-local" id="DataPlanejada" name="DataPlanejada" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="DataIniciada" class="control-label">Data Iniciada</label>
                <input type="datetime-local" id="DataIniciada" name="DataIniciada" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="DataFinalizada" class="control-label">Data Finalizada</label>
                <input type="datetime-local" id="DataFinalizada" name="DataFinalizada" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="DataCancelada" class="control-label">Data Cancelada</label>
                <input type="datetime-local" id="DataCancelada" name="DataCancelada" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="StatusTarefa" class="control-label">Status da Tarefa</label>
                <input type="text" id="StatusTarefa" name="StatusTarefa" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="Prazo" class="control-label">Prazo (Dias)</label>
                <input type="number" id="Prazo" name="Prazo" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="FuncionarioId" class="control-label">Funcionário</label>
                <select id="FuncionarioId" name="FuncionarioId" class="form-control">
                    <option value="">-- Selecione o Funcionário --</option>
                    @if (ViewBag.ListaFuncionario != null)
                    {
                        @foreach (var func in ViewBag.ListaFuncionario)
                        {
                            <option value="@func.Codigo">@func.Nome</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a href="/Tarefa/Index">Back to List</a>
</div>